<nav class="glass fixed top-0 left-0 right-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <%# Logo %>
      <div class="flex items-center gap-2">
        <%= link_to (current_user&.admin? ? admin_root_path : root_path), class: "flex items-center gap-2 text-white font-semibold text-lg" do %>
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span>ExpenseTracker</span>
        <% end %>
      </div>

      <%# Navigation Links %>
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%# Admin Navigation %>
            <%= link_to admin_root_path, class: "nav-link hidden sm:flex" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <span>Dashboard</span>
            <% end %>
          <% else %>
            <%# User Navigation %>
            <%= link_to root_path, class: "nav-link hidden sm:flex" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <span>Dashboard</span>
            <% end %>

            <%= link_to new_expense_path, class: "btn-primary btn-sm inline-flex items-center gap-2", style: "border-radius: 12px;" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span class="hidden sm:inline">Add Expense</span>
            <% end %>
          <% end %>

          <%# Profile Link %>
          <%= link_to profile_path, class: "flex items-center gap-2 ml-2 p-2 rounded-xl hover:bg-dark-surface-elevated transition-colors" do %>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center text-white text-sm font-bold">
              <%= current_user.display_name.first.upcase %>
            </div>
            <div class="hidden sm:block text-left">
              <p class="text-sm font-medium text-white"><%= current_user.display_name %></p>
              <p class="text-xs text-gray-400">
                <% if current_user.admin? %>
                  <span class="text-yellow-400">Admin</span>
                <% else %>
                  View Profile
                <% end %>
              </p>
            </div>
          <% end %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "nav-link" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn-primary btn-sm", style: "border-radius: 12px;" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
