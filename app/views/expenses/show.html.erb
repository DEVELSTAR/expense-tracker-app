<% content_for :title, "Expense Details - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Expense Details</h1>
      <p class="page-subtitle">Viewing expense from <%= @expense.spent_on.strftime("%B %d, %Y") %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to edit_expense_path(@expense), class: "btn-secondary" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>
      <%= link_to root_path, class: "btn-ghost" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back
      <% end %>
    </div>
  </div>

  <div class="card overflow-hidden">
    <%# Amount Header %>
    <div class="bg-gradient-to-r from-primary-600 to-secondary-600 p-8 text-center">
      <p class="text-sm text-white/70 uppercase tracking-wider mb-2">Amount</p>
      <p class="text-4xl font-bold text-white">$<%= number_with_precision(@expense.amount, precision: 2, delimiter: ",") %></p>
    </div>

    <%# Details %>
    <div class="p-6 space-y-6">
      <div class="grid grid-cols-2 gap-6">
        <div>
          <p class="text-sm text-gray-400 mb-1">Date</p>
          <p class="text-lg font-medium text-white"><%= @expense.spent_on.strftime("%B %d, %Y") %></p>
        </div>
        <div>
          <p class="text-sm text-gray-400 mb-1">Category</p>
          <span class="category-<%= @expense.category.downcase.gsub(/\s+/, '-') %>">
            <%= @expense.category.capitalize %>
          </span>
        </div>
        <div>
          <p class="text-sm text-gray-400 mb-1">Spent By</p>
          <span class="<%= @expense.spent_by_self_expense? ? 'badge-primary' : 'badge-secondary' %>">
            <%= @expense.spent_by_label %>
          </span>
        </div>
        <div>
          <p class="text-sm text-gray-400 mb-1">Created</p>
          <p class="text-white"><%= @expense.created_at.strftime("%b %d, %Y at %I:%M %p") %></p>
        </div>
      </div>

      <% if @expense.note.present? %>
        <div class="pt-4 border-t border-dark-border">
          <p class="text-sm text-gray-400 mb-2">Note</p>
          <p class="text-gray-300"><%= @expense.note %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
