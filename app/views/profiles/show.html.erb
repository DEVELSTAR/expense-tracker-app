<% content_for :title, "Profile - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Profile</h1>
      <p class="page-subtitle">Manage your account settings</p>
    </div>
  </div>

  <%# Profile Card %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center text-white text-2xl font-bold">
        <%= @user.display_name.first.upcase %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white"><%= @user.display_name %></h2>
        <p class="text-gray-400"><%= @user.email %></p>
        <% if @user.admin? %>
          <span class="badge-warning mt-1">Admin</span>
        <% else %>
          <span class="badge-secondary mt-1">User</span>
        <% end %>
      </div>
    </div>

    <%# Stats %>
    <% unless @user.admin? %>
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-white"><%= @expense_count %></p>
          <p class="text-sm text-gray-400">Expenses</p>
        </div>
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-primary-400">₹<%= number_with_precision(@total_spent, precision: 0, delimiter: ",") %></p>
          <p class="text-sm text-gray-400">Total Spent</p>
        </div>
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-secondary-400"><%= @funds_count %></p>
          <p class="text-sm text-gray-400">Funds</p>
        </div>
      </div>
    <% end %>

    <%# Account Actions %>
    <div class="border-t border-dark-border pt-6">
      <h3 class="text-lg font-semibold text-white mb-4">Account Settings</h3>
      <div class="space-y-3">
        <%= link_to edit_user_registration_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Edit Profile</p>
            <p class="text-sm text-gray-400">Update your name and email</p>
          </div>
        <% end %>
        
        <%= link_to edit_user_registration_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Change Password</p>
            <p class="text-sm text-gray-400">Update your password</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Admin Quick Links %>
  <% if @user.admin? %>
    <div class="card p-6 md:p-8">
      <h3 class="text-lg font-semibold text-white mb-4">Admin Tools</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= link_to admin_users_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center group-hover:bg-primary-500/30 transition-colors">
            <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-white font-medium">User Management</p>
            <p class="text-sm text-gray-400">Add, edit, or remove users</p>
          </div>
        <% end %>

        <%= link_to admin_funds_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
          <div class="w-12 h-12 rounded-xl bg-secondary-500/20 flex items-center justify-center group-hover:bg-secondary-500/30 transition-colors">
            <svg class="w-6 h-6 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <div>
            <p class="text-white font-medium">Fund Management</p>
            <p class="text-sm text-gray-400">Create and allocate funds</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Logout %>
  <div class="mt-6 text-center">
    <%= button_to destroy_user_session_path, method: :delete, class: "btn-danger", style: "border-radius: 12px; padding: 10px 24px;" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    <% end %>
  </div>
</div>
