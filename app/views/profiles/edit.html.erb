<% content_for :title, "Edit Profile - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Profile</h1>
      <p class="page-subtitle">Update your account information</p>
    </div>
    <%= link_to profile_path, class: "btn-secondary" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Profile
    <% end %>
  </div>

  <div class="card p-6 md:p-8">
    <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <p class="text-red-400 font-medium">Please fix the following errors:</p>
              <ul class="mt-2 text-sm text-red-300 list-disc list-inside">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%# Profile Avatar Preview %>
      <div class="flex items-center gap-4 pb-6 border-b border-dark-border">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br <%= @user.admin? ? 'from-red-500 to-orange-500' : @user.guardian? ? 'from-emerald-500 to-teal-500' : 'from-blue-500 to-indigo-500' %> flex items-center justify-center text-white text-3xl font-bold shadow-lg">
          <%= @user.display_name.first.upcase %>
        </div>
        <div>
          <p class="text-white font-medium text-lg"><%= @user.display_name %></p>
          <p class="text-gray-400"><%= @user.role_label %></p>
          <p class="text-xs text-gray-500 mt-1">Member since <%= @user.created_at.strftime("%B %Y") %></p>
        </div>
      </div>

      <%# Name Field %>
      <div class="input-group">
        <%= f.label :name, class: "input-label" %>
        <%= f.text_field :name, 
            class: "input",
            placeholder: "Your full name",
            autocomplete: "name" %>
      </div>

      <%# Email Field %>
      <div class="input-group">
        <%= f.label :email, class: "input-label" %>
        <%= f.email_field :email, 
            class: "input",
            placeholder: "you@example.com",
            autocomplete: "email" %>
      </div>

      <%# Password Section %>
      <div class="pt-6 border-t border-dark-border">
        <h3 class="text-lg font-semibold text-white mb-4">Change Password</h3>
        <p class="text-sm text-gray-400 mb-4">Leave blank if you don't want to change your password</p>
        
        <div class="space-y-4">
          <div class="input-group">
            <%= f.label :password, "New Password", class: "input-label" %>
            <%= f.password_field :password, 
                class: "input",
                placeholder: "••••••••",
                autocomplete: "new-password" %>
            <p class="text-xs text-gray-500 mt-1">Minimum 6 characters</p>
          </div>

          <div class="input-group">
            <%= f.label :password_confirmation, "Confirm New Password", class: "input-label" %>
            <%= f.password_field :password_confirmation, 
                class: "input",
                placeholder: "••••••••",
                autocomplete: "new-password" %>
          </div>
        </div>
      </div>

      <%# Role Info (Read Only) %>
      <div class="pt-6 border-t border-dark-border">
        <h3 class="text-lg font-semibold text-white mb-4">Account Type</h3>
        <div class="p-4 rounded-xl bg-dark-surface-elevated">
          <div class="flex items-center gap-3">
            <% case @user.role %>
            <% when "admin" %>
              <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-medium">Administrator</p>
                <p class="text-sm text-gray-400">Full system access</p>
              </div>
            <% when "guardian" %>
              <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-medium">Guardian</p>
                <p class="text-sm text-gray-400">Manage family funds and dependents</p>
              </div>
            <% when "dependent" %>
              <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-medium">Dependent</p>
                <p class="text-sm text-gray-400">Track expenses from assigned funds</p>
              </div>
            <% end %>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-2">Account type cannot be changed. Contact an administrator if needed.</p>
      </div>

      <%# Submit Button %>
      <div class="pt-6 flex items-center gap-4">
        <%= f.submit "Save Changes", class: "btn-primary btn-lg" %>
        <%= link_to "Cancel", profile_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
