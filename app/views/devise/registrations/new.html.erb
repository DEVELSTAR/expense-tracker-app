<% content_for :title, "Sign Up - ExpenseTracker" %>

<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-12 animate-fade-in">
  <div class="w-full max-w-md">
    <%# Header %>
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-primary-500/25">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-white mb-2">Create Account</h1>
      <p class="text-gray-400">Start tracking your expenses today</p>
    </div>

    <%# Form Card %>
    <div class="card p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6", id: "registration-form" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# Role Selection %>
        <div class="input-group">
          <%= f.label :role, "Account Type", class: "input-label" %>
          <div class="grid grid-cols-2 gap-3 mt-2">
            <label class="role-option relative cursor-pointer" data-role="guardian">
              <%= f.radio_button :role, "guardian", class: "sr-only peer", id: "role_guardian" %>
              <div class="p-4 rounded-xl border-2 border-dark-border bg-dark-card transition-all duration-200 peer-checked:border-primary-500 peer-checked:bg-primary-500/10 hover:border-gray-600">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  </div>
                  <span class="font-medium text-white">Guardian</span>
                  <span class="text-xs text-gray-500 text-center">Manage family funds</span>
                </div>
              </div>
            </label>

            <label class="role-option relative cursor-pointer" data-role="dependent">
              <%= f.radio_button :role, "dependent", class: "sr-only peer", id: "role_dependent", checked: true %>
              <div class="p-4 rounded-xl border-2 border-dark-border bg-dark-card transition-all duration-200 peer-checked:border-primary-500 peer-checked:bg-primary-500/10 hover:border-gray-600">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                  <span class="font-medium text-white">Dependent</span>
                  <span class="text-xs text-gray-500 text-center">Track your spending</span>
                </div>
              </div>
            </label>
          </div>
        </div>

        <%# Guardian UID Input (only for dependents) %>
        <div class="input-group" id="guardian-field" style="display: block;">
          <%= f.label :guardian_uid_input, "Guardian UID", class: "input-label" %>
          <div class="relative">
            <%= f.text_field :guardian_uid_input, 
                placeholder: "Enter Guardian UID (e.g., GRD-A1B2C3)", 
                class: "input font-mono uppercase tracking-wider",
                autocomplete: "off",
                style: "text-transform: uppercase;" %>
            <div class="absolute right-3 top-1/2 -translate-y-1/2">
              <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
              </svg>
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-1">Ask your guardian for their unique UID code</p>
        </div>

        <div class="input-group">
          <%= f.label :name, class: "input-label" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Your name", class: "input" %>
        </div>

        <div class="input-group">
          <%= f.label :email, class: "input-label" %>
          <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "input" %>
        </div>

        <div class="input-group">
          <%= f.label :password, class: "input-label" %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "input" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div class="input-group">
          <%= f.label :password_confirmation, class: "input-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "input" %>
        </div>

        <div>
          <%= f.submit "Create Account", class: "btn-primary btn-lg w-full" %>
        </div>
      <% end %>

      <%# Footer Links %>
      <div class="mt-6 pt-6 border-t border-dark-border text-center">
        <p class="text-gray-400 text-sm">
          Already have an account?
          <%= link_to "Sign in", new_session_path(resource_name), class: "text-primary-400 hover:text-primary-300 font-medium" %>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const guardianField = document.getElementById('guardian-field');
    const roleGuardian = document.getElementById('role_guardian');
    const roleDependent = document.getElementById('role_dependent');

    function toggleGuardianField() {
      if (roleDependent && roleDependent.checked) {
        guardianField.style.display = 'block';
      } else {
        guardianField.style.display = 'none';
      }
    }

    if (roleGuardian) {
      roleGuardian.addEventListener('change', toggleGuardianField);
    }
    if (roleDependent) {
      roleDependent.addEventListener('change', toggleGuardianField);
    }

    // Initial state
    toggleGuardianField();
  });
</script>
