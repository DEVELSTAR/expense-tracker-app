<% content_for :title, "Categories - ExpenseTracker" %>

<div class="animate-fade-in max-w-4xl mx-auto">
  <div class="page-header mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Manage your expense types</p>
      </div>
      <%= link_to new_category_path, class: "btn-primary" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Category
      <% end %>
    </div>
  </div>

  <% if @categories.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @categories.each do |category| %>
        <div class="card p-5 group flex items-start justify-between hover:border-primary-500/50 transition-colors">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="text-white font-semibold text-lg"><%= category.name.titleize %></h3>
              <% if category.global? %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase tracking-wide">Global</span>
              <% else %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-wide">Personal</span>
              <% end %>
            </div>
            <p class="text-xs text-gray-500">
              <% if category.global? %>
                Available to everyone
              <% else %>
                Created by <%= category.user == current_user ? "You" : category.user.display_name %>
              <% end %>
            </p>
          </div>

          <%# Actions - Only show if user can manage this category %>
          <% if current_user.admin? || category.user_id == current_user.id %>
            <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <%= link_to edit_category_path(category), class: "p-2 rounded-lg hover:bg-dark-border text-gray-400 hover:text-white transition-colors", title: "Edit" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              <% end %>
              
              <%= button_to category_path(category), method: :delete, form: { data: { turbo_confirm: "Are you sure? This effectively removes the category from future use." } }, class: "p-2 rounded-lg hover:bg-dark-border text-gray-400 hover:text-red-400 transition-colors", title: "Delete" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div class="w-16 h-16 rounded-full bg-gray-500/10 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-white mb-2">No categories found</h3>
      <p class="text-gray-400 mb-6">Create your first custom category to start organizing expenses.</p>
      <%= link_to new_category_path, class: "btn-primary inline-flex" do %>
        Create Category
      <% end %>
    </div>
  <% end %>
</div>
