<% content_for :title, "Edit Fund - Admin" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Fund</h1>
      <p class="page-subtitle">Update <%= @fund.name %></p>
    </div>
  </div>

  <div class="card p-6 md:p-8">
    <%= render "form", fund: @fund %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= button_to "Delete this fund", admin_fund_path(@fund),
        method: :delete,
        class: "btn-danger",
        data: { turbo_confirm: "Are you sure you want to delete this fund? This will remove all expenses from this fund." } %>
  </div>
</div>
