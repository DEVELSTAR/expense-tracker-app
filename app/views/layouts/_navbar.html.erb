              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span class="hidden sm:inline">Add Expense</span>
            <% end %>
          <% end %>

          <%# Profile Link %>
          <%= link_to profile_path, class: "flex items-center gap-2 ml-2 p-2 rounded-xl hover:bg-dark-surface-elevated transition-colors" do %>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br <%= current_user.admin? ? 'from-red-500 to-orange-500' : current_user.guardian? ? 'from-emerald-500 to-teal-500' : 'from-blue-500 to-indigo-500' %> flex items-center justify-center text-white text-sm font-bold">
