<% content_for :title, "Profile - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Profile</h1>
      <p class="page-subtitle">Manage your account settings</p>
    </div>
  </div>

  <%# Profile Card %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center text-white text-2xl font-bold">
        <%= @user.display_name.first.upcase %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white"><%= @user.display_name %></h2>
        <p class="text-gray-400"><%= @user.email %></p>
        <div class="flex items-center gap-2 mt-2">
          <% case @user.role %>
          <% when "admin" %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Admin
            </span>
          <% when "guardian" %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7"/>
              </svg>
              Guardian
            </span>
            <% if @user.dependents.any? %>
              <span class="text-xs text-gray-500">(<%= @user.dependents.count %> dependent<%= @user.dependents.count == 1 ? '' : 's' %>)</span>
            <% end %>
          <% when "dependent" %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Dependent
            </span>
            <% if @user.guardian.present? %>
              <span class="text-xs text-gray-500">(Guardian: <%= @user.guardian.display_name %>)</span>
            <% end %>
          <% when "independent" %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-500/10 text-gray-400 border border-gray-500/20">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Independent
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Stats %>
    <% unless @user.admin? %>
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-white"><%= @expense_count %></p>
          <p class="text-sm text-gray-400">Expenses</p>
        </div>
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-primary-400">₹<%= number_with_precision(@total_spent, precision: 0, delimiter: ",") %></p>
          <p class="text-sm text-gray-400">Total Spent</p>
        </div>
        <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
          <p class="text-2xl font-bold text-secondary-400"><%= @funds_count %></p>
          <p class="text-sm text-gray-400">Funds</p>
        </div>
      </div>
    <% end %>

    <%# Guardian UID Section (only for guardians) %>
    <% if @user.guardian? %>
      <div class="border-t border-dark-border pt-6 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold text-white">Your Guardian UID</h3>
          <span class="text-xs text-gray-500">Share this code with your dependents</span>
        </div>
        
        <div class="p-4 rounded-xl bg-gradient-to-r from-emerald-500/10 to-teal-500/10 border border-emerald-500/20">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 mb-1">Your unique code</p>
                <p class="text-2xl font-bold font-mono tracking-wider text-emerald-400" id="guardian-uid"><%= @user.guardian_uid %></p>
              </div>
            </div>
            
            <div class="flex items-center gap-2">
              <button type="button" 
                      onclick="copyUid()" 
                      class="btn-secondary btn-sm"
                      title="Copy UID">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                <span class="hidden sm:inline ml-1">Copy</span>
              </button>
              
              <%= button_to regenerate_guardian_uid_profile_path, 
                  method: :post,
                  class: "btn-ghost btn-sm text-amber-400 hover:text-amber-300",
                  data: { turbo_confirm: "Are you sure you want to regenerate your UID? Dependents using your old code won't be able to link to you anymore." },
                  title: "Generate new UID" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                <span class="hidden sm:inline ml-1">Regenerate</span>
              <% end %>
            </div>
          </div>
        </div>
        
        <p class="text-xs text-gray-500 mt-3">
          <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          When someone registers as a dependent, they'll need to enter this code to link to you as their guardian.
        </p>
      </div>
      
      <script>
        function copyUid() {
          const uid = document.getElementById('guardian-uid').textContent;
          navigator.clipboard.writeText(uid).then(() => {
            alert('UID copied to clipboard!');
          });
        }
      </script>
    <% end %>

    <%# Role Management (for New Users) %>
    <% if @user.independent? %>
      <div class="card p-6 md:p-8 mb-6 border border-primary-500/20">
        <h3 class="text-lg font-semibold text-white mb-4">Setup Family Role</h3>
        <p class="text-gray-400 mb-6">You are currently independent. You can switch to a family role at any time.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%# Guardian Option %>
            <div class="p-4 rounded-xl bg-dark-surface-elevated border border-emerald-500/20 hover:border-emerald-500/40 transition-colors">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <h4 class="font-bold text-white">Become Guardian</h4>
                </div>
                <p class="text-sm text-gray-400 mb-4 h-10">Create funds and manage expenses for family members.</p>
                <%= button_to "Switch to Guardian", become_guardian_onboarding_index_path, method: :post, class: "btn-primary btn-sm w-full justify-center" %>
            </div>

            <%# Dependent Option %>
            <div class="p-4 rounded-xl bg-dark-surface-elevated border border-blue-500/20 hover:border-blue-500/40 transition-colors">
                 <div class="flex items-center gap-3 mb-2">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                        </svg>
                    </div>
                    <h4 class="font-bold text-white">Join Family</h4>
                 </div>
                 <p class="text-sm text-gray-400 mb-4 h-10">Link to an existing Guardian using their UID.</p>
                 <%= form_with url: become_dependent_onboarding_index_path, method: :post, class: "space-y-3" do |f| %>
                  <%= f.text_field :guardian_uid_input, placeholder: "Enter Guardian UID", class: "input input-sm text-center uppercase tracking-wider font-mono", required: true %>
                  <%= f.submit "Link & Switch", class: "btn-secondary btn-sm w-full" %>
                 <% end %>
            </div>
        </div>
      </div>
    <% end %>

    <%# Account Actions %>
    <div class="border-t border-dark-border pt-6">
      <h3 class="text-lg font-semibold text-white mb-4">Account Settings</h3>
      <div class="space-y-3">
        <%= link_to edit_user_registration_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Edit Profile</p>
            <p class="text-sm text-gray-400">Update your name and email</p>
          </div>
        <% end %>
        
        <%= link_to funds_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Personal Funds</p>
            <p class="text-sm text-gray-400">Manage your own budgets</p>
          </div>
        <% end %>

        <%= link_to shopping_list_items_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <div>
            <p class="text-white font-medium">My Shopping List</p>
            <p class="text-sm text-gray-400">Remember what to buy</p>
          </div>
        <% end %>

        <%= link_to categories_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <div>
            <p class="text-white font-medium">My Categories</p>
            <p class="text-sm text-gray-400">Manage custom expense types</p>
          </div>
        <% end %>

        <%= link_to edit_user_registration_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Change Password</p>
            <p class="text-sm text-gray-400">Update your password</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Admin Quick Links %>
  <% if @user.admin? %>
    <div class="card p-6 md:p-8">
      <h3 class="text-lg font-semibold text-white mb-4">Admin Tools</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= link_to admin_users_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center group-hover:bg-primary-500/30 transition-colors">
            <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-white font-medium">User Management</p>
            <p class="text-sm text-gray-400">Add, edit, or remove users</p>
          </div>
        <% end %>

        <%= link_to admin_funds_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
          <div class="w-12 h-12 rounded-xl bg-secondary-500/20 flex items-center justify-center group-hover:bg-secondary-500/30 transition-colors">
            <svg class="w-6 h-6 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <div>
            <p class="text-white font-medium">Fund Management</p>
            <p class="text-sm text-gray-400">Create and allocate funds</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Logout %>
  <div class="mt-6 text-center">
    <%= button_to destroy_user_session_path, method: :delete, class: "btn-danger", style: "border-radius: 12px; padding: 10px 24px;" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    <% end %>
  </div>
</div>
