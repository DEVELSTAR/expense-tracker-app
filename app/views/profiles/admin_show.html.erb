<% content_for :title, "Admin Profile - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Admin Profile</h1>
      <p class="page-subtitle">System administration overview</p>
    </div>
  </div>

  <%# Profile Card %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-red-500/25">
        <%= @user.display_name.first.upcase %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white"><%= @user.display_name %></h2>
        <p class="text-gray-400"><%= @user.email %></p>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20 mt-2">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Administrator
        </span>
      </div>
    </div>

    <%# System Stats %>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-white"><%= @total_users %></p>
        <p class="text-sm text-gray-400">Total Users</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-emerald-400"><%= @total_guardians %></p>
        <p class="text-sm text-gray-400">Guardians</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-blue-400"><%= @total_dependents %></p>
        <p class="text-sm text-gray-400">Dependents</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-secondary-400"><%= @total_funds %></p>
        <p class="text-sm text-gray-400">Total Funds</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-amber-400"><%= @total_expenses %></p>
        <p class="text-sm text-gray-400">Total Expenses</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-primary-400">₹<%= number_with_precision(@total_amount, precision: 0, delimiter: ",") %></p>
        <p class="text-sm text-gray-400">Total Amount</p>
      </div>
    </div>

    <%# Edit Profile Link %>
    <div class="border-t border-dark-border pt-6">
      <h3 class="text-lg font-semibold text-white mb-4">Account Settings</h3>
      <div class="space-y-3">
        <%= link_to edit_profile_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Edit Profile</p>
            <p class="text-sm text-gray-400">Update your name, email and password</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Admin Tools %>
  <div class="card p-6 md:p-8 mb-6">
    <h3 class="text-lg font-semibold text-white mb-4">Admin Tools</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <%= link_to admin_users_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
        <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center group-hover:bg-primary-500/30 transition-colors">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-white font-medium">User Management</p>
          <p class="text-sm text-gray-400">Add, edit, or remove users</p>
        </div>
      <% end %>

      <%= link_to admin_funds_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
        <div class="w-12 h-12 rounded-xl bg-secondary-500/20 flex items-center justify-center group-hover:bg-secondary-500/30 transition-colors">
          <svg class="w-6 h-6 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <div>
          <p class="text-white font-medium">Fund Management</p>
          <p class="text-sm text-gray-400">Create and allocate funds</p>
        </div>
      <% end %>

      <%= link_to admin_expenses_path, class: "flex items-center gap-4 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors group" do %>
        <div class="w-12 h-12 rounded-xl bg-amber-500/20 flex items-center justify-center group-hover:bg-amber-500/30 transition-colors">
          <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <div>
          <p class="text-white font-medium">Expense Management</p>
          <p class="text-sm text-gray-400">View and manage all expenses</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Recent System Activity %>
  <div class="card mb-6">
    <div class="p-4 border-b border-dark-border">
      <h3 class="text-lg font-semibold text-white">Recent System Activity</h3>
    </div>
    <div class="divide-y divide-dark-border">
      <% if @recent_activities.any? %>
        <% @recent_activities.each do |activity| %>
          <div class="p-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-xs font-bold text-gray-300">
                <%= activity.user.display_name.first.upcase %>
              </div>
              <div>
                <p class="text-sm text-gray-300">
                  <span class="font-medium text-white"><%= activity.user.display_name %></span>
                  <%= activity.action.humanize.downcase %>
                  <% if activity.trackable %>
                     <%= activity.trackable_type.downcase %>
                  <% end %>
                </p>
                <p class="text-xs text-gray-500"><%= time_ago_in_words(activity.created_at) %> ago</p>
              </div>
            </div>
            <% if activity.ip_address %>
              <span class="text-xs text-gray-600 font-mono"><%= activity.ip_address %></span>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="p-6 text-center text-gray-500">
          No recent activity found.
        </div>
      <% end %>
    </div>
  </div>

  <%# Logout %>
  <div class="text-center">
    <%= button_to destroy_user_session_path, method: :delete, class: "btn-danger", style: "border-radius: 12px; padding: 10px 24px;" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    <% end %>
  </div>
</div>
