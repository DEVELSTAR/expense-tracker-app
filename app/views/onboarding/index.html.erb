<% content_for :title, "Welcome - Select Your Role" %>

<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-12 animate-fade-in">
  <div class="w-full max-w-4xl">
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold text-white mb-4">Welcome to ExpenseTracker</h1>
      <p class="text-xl text-gray-400">How would you like to use the app?</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 px-4">
      <%# Guardian Option %>
      <div class="card p-8 hover:border-primary-500/50 transition-colors group">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-2">I am a Guardian</h2>
        <p class="text-gray-400 mb-6">Create and manage your family's expense funds. You will be able to assign funds to dependents and track their spending.</p>
        
        <%= button_to "Continue as Guardian", become_guardian_onboarding_index_path, method: :post, class: "btn-primary w-full justify-center" %>
      </div>

      <%# Dependent Option %>
      <div class="card p-8 hover:border-secondary-500/50 transition-colors group">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-2">I am a Dependent</h2>
        <p class="text-gray-400 mb-6">Join your family group using a Guardian UID. You can request expenses and track your spending from assigned funds.</p>
        
        <%= form_with url: become_dependent_onboarding_index_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :guardian_uid_input, "Enter Guardian UID", class: "block text-sm font-medium text-gray-400 mb-1" %>
            <%= f.text_field :guardian_uid_input, placeholder: "e.g., GRD-X1Y2Z3", class: "input uppercase text-center font-mono tracking-widest", required: true %>
          </div>
          <%= f.submit "Continue as Dependent", class: "btn-secondary w-full" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
