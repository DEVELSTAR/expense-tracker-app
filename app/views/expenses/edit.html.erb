<% content_for :title, "Edit Expense - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Expense</h1>
      <p class="page-subtitle">Update expense details</p>
    </div>
  </div>

  <div class="card p-6 md:p-8">
    <%= render "form", expense: @expense %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= button_to "Delete this expense", expense_path(@expense), 
        method: :delete,
        class: "btn-danger",
        data: { turbo_confirm: "Are you sure you want to delete this expense? This action cannot be undone." } %>
  </div>
</div>
