<% content_for :title, "Dashboard - ExpenseTracker" %>

<div class="animate-fade-in">
  <%# Page Header %>
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">
        <% if current_user.guardian? %>
          Welcome back, Guardian! Manage your family's expenses.
        <% elsif current_user.dependent? %>
          Track your spending and manage your funds.
        <% else %>
          Track and manage your expenses
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if current_user.guardian? %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7"/>
          </svg>
          Guardian
        </span>
      <% elsif current_user.dependent? %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Dependent
          <% if current_user.guardian.present? %>
            <span class="text-gray-500">(Guardian: <%= current_user.guardian.display_name %>)</span>
          <% end %>
        </span>
      <% end %>
    </div>
  </div>

  <%# Guardian's Dependents Overview %>
  <% if current_user.guardian? && @dependents.present? %>
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-white">Your Dependents</h2>
        <span class="text-sm text-gray-400"><%= @dependents.count %> dependent<%= @dependents.count == 1 ? '' : 's' %></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @dependents.each do |dependent| %>
          <% dependent_expenses = dependent.expenses.by_month(@current_month) %>
          <% dependent_total = dependent_expenses.sum(:amount) %>
          <div class="card p-5 border-l-4 border-l-blue-500">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white font-medium">
                <%= dependent.display_name[0].upcase %>
              </div>
              <div>
                <h3 class="font-semibold text-white"><%= dependent.display_name %></h3>
                <p class="text-xs text-gray-500"><%= dependent.email %></p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-3 rounded-lg bg-dark-surface-elevated">
                <p class="text-lg font-bold text-red-400">₹<%= number_with_precision(dependent_total, precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">This Month</p>
              </div>
              <div class="text-center p-3 rounded-lg bg-dark-surface-elevated">
                <p class="text-lg font-bold text-gray-400"><%= dependent_expenses.count %></p>
                <p class="text-xs text-gray-500">Expenses</p>
              </div>
            </div>
          </div>
        <% end %>
        
        <%# Summary Card %>
        <div class="card p-5 border-l-4 border-l-emerald-500 bg-gradient-to-br from-emerald-500/5 to-transparent">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Dependents Total</h3>
              <p class="text-xs text-gray-500"><%= @current_month.strftime("%B %Y") %></p>
            </div>
          </div>
          <div class="text-center p-3 rounded-lg bg-dark-surface-elevated">
            <p class="text-2xl font-bold text-emerald-400">₹<%= number_with_precision(@dependents_total_spent, precision: 0, delimiter: ",") %></p>
            <p class="text-xs text-gray-500">Combined Spending</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Assigned Funds %>
  <% if @assigned_funds.any? %>
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-white mb-4">Assigned Funds</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @assigned_funds.each do |fund| %>
          <div class="card p-5">
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-semibold text-white"><%= fund.name %></h3>
              <span class="text-xs text-gray-500"><%= fund.users.count %> users</span>
            </div>
            
            <%# Progress Bar %>
            <div class="mb-3">
              <% spent_percent = fund.amount > 0 ? (fund.total_spent / fund.amount * 100).clamp(0, 100) : 0 %>
              <div class="w-full h-2 bg-dark-surface-elevated rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= spent_percent > 80 ? 'bg-red-500' : spent_percent > 50 ? 'bg-yellow-500' : 'bg-green-500' %>" style="width: <%= spent_percent %>%"></div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 text-center">
              <div>
                <p class="text-lg font-bold text-green-400">₹<%= number_with_precision(fund.remaining_balance, precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">Left</p>
              </div>
              <div>
                <p class="text-lg font-bold text-primary-400">₹<%= number_with_precision(fund.spent_by_user(current_user), precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">You Spent</p>
              </div>
              <div>
                <p class="text-lg font-bold text-gray-400">₹<%= number_with_precision(fund.spent_by_others(current_user), precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">Others</p>
              </div>
            </div>

             <%# User breakdown %>
            <% if fund.users.count > 1 %>
              <div class="mt-3 pt-3 border-t border-dark-border">
                <p class="text-xs text-gray-500 mb-2">Breakdown:</p>
                <div class="space-y-1">
                  <% fund.users.each do |user| %>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-gray-400"><%= user == current_user ? "You" : user.display_name %></span>
                      <span class="text-white">₹<%= number_with_precision(fund.spent_by_user(user), precision: 0, delimiter: ",") %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Personal Funds %>
  <% if @personal_funds.any? %>
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-white mb-4">My Personal Funds</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @personal_funds.each do |fund| %>
          <div class="card p-5 border-l-4 border-l-secondary-500">
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-semibold text-white"><%= fund.name %></h3>
              <span class="text-xs text-gray-500">Personal</span>
            </div>
            
            <%# Progress Bar %>
            <div class="mb-3">
              <% spent_percent = fund.amount > 0 ? (fund.total_spent / fund.amount * 100).clamp(0, 100) : 0 %>
              <div class="w-full h-2 bg-dark-surface-elevated rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= spent_percent > 80 ? 'bg-red-500' : spent_percent > 50 ? 'bg-yellow-500' : 'bg-green-500' %>" style="width: <%= spent_percent %>%"></div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 text-center">
              <div>
                <p class="text-lg font-bold text-green-400">₹<%= number_with_precision(fund.remaining_balance, precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">Remaining</p>
              </div>
              <div>
                <p class="text-lg font-bold text-red-400">₹<%= number_with_precision(fund.total_spent, precision: 0, delimiter: ",") %></p>
                <p class="text-xs text-gray-500">Total Spent</p>
              </div>
            </div>
            
            <div class="mt-4">
               <%= link_to "View Details", funds_path, class: "text-sm text-secondary-400 hover:text-secondary-300" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Filters %>
  <div class="filter-bar mb-8">
    <%= form_with url: root_path, method: :get, class: "flex flex-wrap items-end gap-4 w-full", data: { turbo_frame: "_top" } do |f| %>
      <div class="input-group flex-1 min-w-[200px]">
        <%= f.label :month, "Month", class: "input-label" %>
        <%= f.month_field :month, value: @current_month.strftime("%Y-%m"), class: "input", style: "border-radius: 12px;" %>
      </div>
      
      <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary" style="border-radius: 12px; padding: 10px 20px;">Apply Filters</button>
        <%= link_to "Reset", root_path, class: "btn-secondary", style: "border-radius: 12px; padding: 10px 20px;" %>
      </div>
    <% end %>
  </div>

  <%# Stats Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
    <%# Monthly Total %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.1s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-primary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="stat-label">Monthly Total</span>
      </div>
      <p class="stat-value">₹<%= number_with_precision(@monthly_total, precision: 2, delimiter: ",") %></p>
      <p class="text-sm text-gray-500"><%= @current_month.strftime("%B %Y") %></p>
    </div>

    <%# Number of Expenses %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.15s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-secondary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <span class="stat-label">Transactions</span>
      </div>
      <p class="stat-value"><%= @expense_count %></p>
      <p class="text-sm text-gray-500">This month</p>
    </div>

    <%# Average per Transaction %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.2s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
          </svg>
        </div>
        <span class="stat-label">Average</span>
      </div>
      <p class="stat-value">₹<%= @expense_count > 0 ? number_with_precision(@monthly_total / @expense_count, precision: 2, delimiter: ",") : "0.00" %></p>
      <p class="text-sm text-gray-500">Per transaction</p>
    </div>
  </div>

  <%# Category Breakdown %>
  <% if @category_totals.any? %>
    <div class="card p-6 mb-8 animate-slide-up" style="animation-delay: 0.3s">
      <h2 class="text-lg font-semibold text-white mb-4">Category Breakdown</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        <% @category_totals.each do |category, total| %>
          <div class="p-4 rounded-xl bg-dark-surface-elevated text-center">
            <span class="text-xs px-2 py-1 rounded-full bg-primary-500/20 text-primary-300"><%= category.capitalize %></span>
            <p class="text-lg font-semibold text-white mt-2">₹<%= number_with_precision(total, precision: 2, delimiter: ",") %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Expenses List %>
  <div class="card animate-slide-up" style="animation-delay: 0.35s">
    <div class="p-6 border-b border-dark-border">
      <h2 class="text-lg font-semibold text-white">Recent Expenses</h2>
    </div>
    
    <% if @expenses.any? %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Category</th>
              <th>Fund</th>
              <th>Note</th>
              <th class="text-right">Amount</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @expenses.each do |expense| %>
              <tr>
                <td class="text-gray-300">
                  <div class="flex items-center gap-2">
                    <span class="text-gray-400"><%= expense.spent_on.strftime("%b") %></span>
                    <span class="text-xl font-semibold"><%= expense.spent_on.day %></span>
                  </div>
                </td>
                <td>
                  <span class="text-xs px-2 py-1 rounded-full bg-primary-500/20 text-primary-300">
                    <%= expense.category.capitalize %>
                  </span>
                </td>
                <td>
                  <span class="text-sm text-gray-400"><%= expense.fund_name %></span>
                </td>
                <td class="text-gray-400 max-w-xs truncate">
                  <%= expense.note.presence || "—" %>
                </td>
                <td class="text-right">
                  <span class="expense-amount-negative">-₹<%= number_with_precision(expense.amount, precision: 2, delimiter: ",") %></span>
                </td>
                <td class="text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_expense_path(expense), class: "btn-ghost btn-sm" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    <% end %>
                    <%= button_to expense_path(expense), method: :delete, 
                        class: "btn-ghost btn-sm text-red-400 hover:text-red-300",
                        data: { turbo_confirm: "Are you sure you want to delete this expense?" } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">💰</div>
        <h3 class="empty-state-title">No expenses yet</h3>
        <p class="empty-state-description mb-6">
          Start tracking your expenses by adding your first one.
        </p>
        <%= link_to new_expense_path, class: "btn-primary inline-flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span>Add Your First Expense</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
