<% content_for :title, "Dashboard - ExpenseTracker" %>

<div class="animate-fade-in">
  <%# Page Header %>
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Track and manage your expenses</p>
    </div>
    <%= link_to new_expense_path, class: "btn-primary btn-lg" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Add Expense
    <% end %>
  </div>

  <%# Filters %>
  <div class="filter-bar mb-8">
    <%= form_with url: root_path, method: :get, class: "flex flex-wrap items-end gap-4 w-full", data: { turbo_frame: "_top" } do |f| %>
      <div class="input-group flex-1 min-w-[200px]">
        <%= f.label :month, "Month", class: "input-label" %>
        <%= f.month_field :month, value: @current_month.strftime("%Y-%m"), class: "input" %>
      </div>
      
      <div class="input-group flex-1 min-w-[150px]">
        <%= f.label :spent_by, "Spent By", class: "input-label" %>
        <%= f.select :spent_by, 
            options_for_select([["All", ""], ["Self", "self_expense"], ["Wife", "wife"]], params[:spent_by]), 
            {}, 
            class: "select" %>
      </div>
      
      <div class="flex items-center gap-2">
        <%= f.submit "Apply Filters", class: "btn-primary" %>
        <%= link_to "Reset", root_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>

  <%# Stats Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <%# Monthly Total %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.1s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-primary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="stat-label">Monthly Total</span>
      </div>
      <p class="stat-value">$<%= number_with_precision(@monthly_total, precision: 2, delimiter: ",") %></p>
      <p class="text-sm text-gray-500"><%= @current_month.strftime("%B %Y") %></p>
    </div>

    <%# Number of Expenses %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.15s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-secondary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <span class="stat-label">Transactions</span>
      </div>
      <p class="stat-value"><%= @expense_count %></p>
      <p class="text-sm text-gray-500">This month</p>
    </div>

    <%# Self Expenses %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.2s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <span class="stat-label">Self</span>
      </div>
      <p class="stat-value">$<%= number_with_precision(@spent_by_totals["self_expense"] || 0, precision: 2, delimiter: ",") %></p>
      <p class="text-sm text-gray-500">Your expenses</p>
    </div>

    <%# Wife Expenses %>
    <div class="stat-card animate-slide-up" style="animation-delay: 0.25s">
      <div class="flex items-center gap-3 text-gray-400 mb-2">
        <div class="w-10 h-10 rounded-xl bg-pink-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <span class="stat-label">Wife</span>
      </div>
      <p class="stat-value">$<%= number_with_precision(@spent_by_totals["wife"] || 0, precision: 2, delimiter: ",") %></p>
      <p class="text-sm text-gray-500">Wife's expenses</p>
    </div>
  </div>

  <%# Category Breakdown %>
  <% if @category_totals.any? %>
    <div class="card p-6 mb-8 animate-slide-up" style="animation-delay: 0.3s">
      <h2 class="text-lg font-semibold text-white mb-4">Category Breakdown</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        <% @category_totals.each do |category, total| %>
          <div class="p-4 rounded-xl bg-dark-surface-elevated text-center">
            <span class="category-<%= category.downcase.gsub(/\s+/, '-') %>"><%= category.capitalize %></span>
            <p class="text-lg font-semibold text-white mt-2">$<%= number_with_precision(total, precision: 2, delimiter: ",") %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Expenses List %>
  <div class="card animate-slide-up" style="animation-delay: 0.35s">
    <div class="p-6 border-b border-dark-border">
      <h2 class="text-lg font-semibold text-white">Recent Expenses</h2>
    </div>
    
    <% if @expenses.any? %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Category</th>
              <th>Spent By</th>
              <th>Note</th>
              <th class="text-right">Amount</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @expenses.each do |expense| %>
              <tr>
                <td class="text-gray-300">
                  <div class="flex items-center gap-2">
                    <span class="text-gray-400"><%= expense.spent_on.strftime("%b") %></span>
                    <span class="text-xl font-semibold"><%= expense.spent_on.day %></span>
                  </div>
                </td>
                <td>
                  <span class="category-<%= expense.category.downcase.gsub(/\s+/, '-') %>">
                    <%= expense.category.capitalize %>
                  </span>
                </td>
                <td>
                  <span class="<%= expense.spent_by_self_expense? ? 'badge-primary' : 'badge-secondary' %>">
                    <%= expense.spent_by_label %>
                  </span>
                </td>
                <td class="text-gray-400 max-w-xs truncate">
                  <%= expense.note.presence || "—" %>
                </td>
                <td class="text-right">
                  <span class="expense-amount-negative">-$<%= number_with_precision(expense.amount, precision: 2, delimiter: ",") %></span>
                </td>
                <td class="text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_expense_path(expense), class: "btn-ghost btn-sm" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                    <% end %>
                    <%= button_to expense_path(expense), method: :delete, 
                        class: "btn-ghost btn-sm text-red-400 hover:text-red-300",
                        data: { turbo_confirm: "Are you sure you want to delete this expense?" } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">💰</div>
        <h3 class="empty-state-title">No expenses yet</h3>
        <p class="empty-state-description mb-6">
          Start tracking your expenses by adding your first one.
        </p>
        <%= link_to new_expense_path, class: "btn-primary" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Add Your First Expense
        <% end %>
      </div>
    <% end %>
  </div>
</div>
