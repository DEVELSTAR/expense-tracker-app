<%= form_with model: [:admin, user], class: "space-y-6" do |f| %>
  <% if user.errors.any? %>
    <div class="alert-error">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h3 class="font-medium"><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h3>
          <ul class="mt-2 list-disc list-inside text-sm">
            <% user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="form-grid">
    <%# Role Selection %>
    <div class="input-group col-span-full">
      <%= f.label :role, "Role", class: "input-label" %>
      <div class="grid grid-cols-3 gap-3 mt-2">
        <% User::ROLES.each do |role| %>
          <label class="role-option relative cursor-pointer">
            <%= f.radio_button :role, role, class: "sr-only peer", id: "user_role_#{role}" %>
            <div class="p-4 rounded-xl border-2 border-dark-border bg-dark-card transition-all duration-200 peer-checked:border-primary-500 peer-checked:bg-primary-500/10 hover:border-gray-600 text-center">
              <div class="flex flex-col items-center gap-2">
                <% case role %>
                <% when "admin" %>
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                  </div>
                <% when "guardian" %>
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  </div>
                <% when "dependent" %>
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                <% end %>
                <span class="font-medium text-white"><%= role.titleize %></span>
              </div>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <%# Guardian Selection (only for dependents) %>
    <div class="input-group col-span-full" id="guardian-field-admin">
      <%= f.label :guardian_id, "Guardian", class: "input-label" %>
      <% if @guardians.any? %>
        <%= f.select :guardian_id, 
            @guardians.map { |g| ["#{g.display_name} (#{g.guardian_uid})", g.id] },
            { include_blank: "Select a guardian..." }, 
            { class: "input" } %>
        <p class="text-xs text-gray-500 mt-1">Required for dependent users. UIDs shown in parentheses.</p>
      <% else %>
        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 text-sm">
          <p>No guardians available. Create a guardian user first to assign dependents.</p>
        </div>
      <% end %>
    </div>

    <div class="input-group">
      <%= f.label :name, class: "input-label" %>
      <%= f.text_field :name, placeholder: "Full name", class: "input" %>
    </div>

    <div class="input-group">
      <%= f.label :email, class: "input-label" %>
      <%= f.email_field :email, placeholder: "email@example.com", class: "input" %>
    </div>

    <div class="input-group">
      <%= f.label :password, class: "input-label" %>
      <%= f.password_field :password, placeholder: user.new_record? ? "Password" : "Leave blank to keep current", class: "input" %>
      <% if user.persisted? %>
        <p class="text-xs text-gray-500 mt-1">Leave blank to keep current password</p>
      <% end %>
    </div>

    <div class="input-group">
      <%= f.label :password_confirmation, "Confirm Password", class: "input-label" %>
      <%= f.password_field :password_confirmation, placeholder: "Confirm password", class: "input" %>
    </div>
  </div>

  <div class="form-actions border-t border-dark-border pt-6">
    <%= f.submit user.new_record? ? "Create User" : "Update User", class: "btn-primary btn-lg" %>
    <%= link_to "Cancel", admin_users_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const guardianField = document.getElementById('guardian-field-admin');
    const roleRadios = document.querySelectorAll('input[name="user[role]"]');

    function toggleGuardianField() {
      const selectedRole = document.querySelector('input[name="user[role]"]:checked');
      if (guardianField) {
        if (selectedRole && selectedRole.value === 'dependent') {
          guardianField.style.display = 'block';
        } else {
          guardianField.style.display = 'none';
        }
      }
    }

    roleRadios.forEach(function(radio) {
      radio.addEventListener('change', toggleGuardianField);
    });

    // Initial state
    toggleGuardianField();
  });
</script>
