<% content_for :title, "Recurring Expenses - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Recurring Expenses</h1>
      <p class="page-subtitle">Automate your regular expenses</p>
    </div>
    <%= link_to new_recurring_expense_path, class: "btn-primary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <span>New Recurring</span>
    <% end %>
  </div>

  <%# Summary Stats %>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
    <div class="card p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-white"><%= @active_count %></p>
          <p class="text-xs text-gray-500">Active</p>
        </div>
      </div>
    </div>
    
    <div class="card p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-secondary-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-white">₹<%= number_with_precision(@total_monthly, precision: 0, delimiter: ",") %></p>
          <p class="text-xs text-gray-500">Est. Monthly</p>
        </div>
      </div>
    </div>
    
    <div class="card p-4 hidden sm:block">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-white"><%= @recurring_expenses.count %></p>
          <p class="text-xs text-gray-500">Total</p>
        </div>
      </div>
    </div>
  </div>

  <%# Recurring Expenses List %>
  <div class="card">
    <% if @recurring_expenses.any? %>
      <div class="divide-y divide-dark-border">
        <% @recurring_expenses.each do |re| %>
          <div class="p-4 hover:bg-dark-surface-elevated transition-colors <%= re.active? ? '' : 'opacity-50' %>">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl <%= re.active? ? 'bg-primary-500/20' : 'bg-gray-500/20' %> flex items-center justify-center">
                  <svg class="w-6 h-6 <%= re.active? ? 'text-primary-400' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-semibold text-white"><%= re.name %></h3>
                    <span class="text-xs px-2 py-0.5 rounded-full <%= re.active? ? 'bg-emerald-500/20 text-emerald-400' : 'bg-gray-500/20 text-gray-400' %>">
                      <%= re.active? ? 'Active' : 'Paused' %>
                    </span>
                  </div>
                  <p class="text-sm text-gray-400">
                    <%= re.category.titleize %> • <%= re.frequency_label %>
                    <% if re.fund.present? %>
                      • From <%= re.fund.name %>
                    <% end %>
                  </p>
                  <p class="text-xs text-gray-500 mt-1">
                    <% if re.active? %>
                      Next: <%= re.next_run_date.strftime("%b %d, %Y") %>
                      <% if re.due? %>
                        <span class="text-orange-400">(Due today!)</span>
                      <% end %>
                    <% else %>
                      Paused
                    <% end %>
                  </p>
                </div>
              </div>
              
              <div class="flex items-center gap-4">
                <p class="text-lg font-bold text-white"><%= re.formatted_amount %></p>
                
                <div class="flex items-center gap-1">
                  <%= button_to toggle_recurring_expense_path(re), method: :post, class: "btn-ghost btn-sm", title: re.active? ? "Pause" : "Activate" do %>
                    <% if re.active? %>
                      <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    <% else %>
                      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    <% end %>
                  <% end %>
                  
                  <%= link_to edit_recurring_expense_path(re), class: "btn-ghost btn-sm" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                  
                  <%= button_to recurring_expense_path(re), method: :delete, 
                      class: "btn-ghost btn-sm text-red-400 hover:text-red-300",
                      data: { turbo_confirm: "Delete recurring expense '#{re.name}'?" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state py-12">
        <div class="empty-state-icon">🔄</div>
        <h3 class="empty-state-title">No recurring expenses</h3>
        <p class="empty-state-description mb-6">
          Set up automatic expenses for bills, subscriptions, and regular payments.
        </p>
        <%= link_to new_recurring_expense_path, class: "btn-primary inline-flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span>Create Your First Recurring Expense</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
