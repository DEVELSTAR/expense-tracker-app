<% content_for :title, "#{@recurring_expense.persisted? ? 'Edit' : 'New'} Recurring Expense - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= @recurring_expense.persisted? ? 'Edit' : 'New' %> Recurring Expense</h1>
      <p class="page-subtitle">Set up automatic recurring expenses</p>
    </div>
  </div>

  <div class="card p-6">
    <%= form_with model: @recurring_expense, class: "space-y-6" do |f| %>
      <% if @recurring_expense.errors.any? %>
        <div class="alert-error">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-medium"><%= pluralize(@recurring_expense.errors.count, "error") %> prohibited saving:</h3>
              <ul class="mt-2 list-disc list-inside text-sm">
                <% @recurring_expense.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%# Name %>
      <div class="input-group">
        <%= f.label :name, "Name", class: "input-label" %>
        <%= f.text_field :name, placeholder: "e.g., Netflix Subscription, Rent, Gym Membership", class: "input" %>
        <p class="text-xs text-gray-500 mt-1">A descriptive name for this recurring expense</p>
      </div>

      <div class="form-grid">
        <%# Amount %>
        <div class="input-group">
          <%= f.label :amount, class: "input-label" %>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">₹</span>
            <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "0.00", class: "input pl-10" %>
          </div>
        </div>

        <%# Frequency %>
        <div class="input-group">
          <%= f.label :frequency, class: "input-label" %>
          <%= f.select :frequency, 
              options_for_select([
                ['Daily', 'daily'],
                ['Weekly', 'weekly'],
                ['Every 2 Weeks', 'biweekly'],
                ['Monthly', 'monthly'],
                ['Quarterly (3 months)', 'quarterly'],
                ['Yearly', 'yearly']
              ], @recurring_expense.frequency),
              {},
              class: "select" %>
        </div>

        <%# Category %>
        <div class="input-group">
          <%= f.label :category, class: "input-label" %>
          <%= f.collection_select :category_id, 
              Category.available_to(current_user).order(:name), 
              :id, :name, 
              { include_blank: "Select category" },
              class: "select" %>
        </div>

        <%# Next Run Date %>
        <div class="input-group">
          <%= f.label :next_run_date, "Start Date", class: "input-label" %>
          <%= f.date_field :next_run_date, class: "input" %>
          <p class="text-xs text-gray-500 mt-1">When should this expense first occur?</p>
        </div>
      </div>

      <%# Fund Selection %>
      <% if @funds.present? && @funds.any? %>
        <div class="input-group">
          <%= f.label :fund_id, "Pay From Fund", class: "input-label" %>
          <%= f.select :fund_id,
              options_for_select(
                @funds.map { |fund| ["#{fund.name} (₹#{number_with_precision(fund.remaining_balance, precision: 0, delimiter: ',')} left)", fund.id] },
                @recurring_expense.fund_id
              ),
              { include_blank: "Personal (No Fund)" },
              class: "select" %>
          <p class="text-xs text-gray-500 mt-1">Select a fund to deduct from when this expense runs</p>
        </div>
      <% end %>

      <%# Note %>
      <div class="input-group">
        <%= f.label :note, "Note (optional)", class: "input-label" %>
        <%= f.text_area :note, 
            placeholder: "Additional details about this recurring expense...",
            rows: 2,
            class: "textarea" %>
      </div>

      <%# Form Actions %>
      <div class="form-actions border-t border-dark-border pt-6">
        <%= f.submit @recurring_expense.persisted? ? "Update Recurring Expense" : "Create Recurring Expense", class: "btn-primary btn-lg" %>
        <%= link_to "Cancel", recurring_expenses_path, class: "btn-secondary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>
