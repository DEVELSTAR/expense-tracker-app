<% content_for :title, "Expense Details - ExpenseTracker" %>

<div class="max-w-2xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Expense Details</h1>
      <p class="page-subtitle">View expense information</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to edit_expense_path(@expense), class: "btn-secondary inline-flex items-center gap-2" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        <span>Edit</span>
      <% end %>
      <%= link_to root_path, class: "btn-ghost" do %>
        Back to Dashboard
      <% end %>
    </div>
  </div>

  <div class="card">
    <%# Amount Header %>
    <div class="p-6 md:p-8 border-b border-dark-border text-center">
      <span class="text-4xl md:text-5xl font-bold text-gradient">
        ₹<%= number_with_precision(@expense.amount, precision: 2, delimiter: ",") %>
      </span>
      <p class="text-gray-400 mt-2">
        <%= @expense.spent_on.strftime("%A, %B %d, %Y") %>
      </p>
    </div>

    <%# Details %>
    <div class="p-6 md:p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%# Category %>
        <div>
          <label class="text-sm text-gray-500 uppercase tracking-wide">Category</label>
          <p class="mt-1">
            <span class="category-<%= @expense.category.downcase.gsub(/\s+/, '-') %>">
              <%= @expense.category.capitalize %>
            </span>
          </p>
        </div>

        <%# Created By %>
        <div>
          <label class="text-sm text-gray-500 uppercase tracking-wide">Created By</label>
          <p class="mt-1">
            <span class="badge-primary"><%= @expense.creator_name %></span>
          </p>
        </div>
      </div>

      <%# Note %>
      <% if @expense.note.present? %>
        <div>
          <label class="text-sm text-gray-500 uppercase tracking-wide">Note</label>
          <p class="mt-1 text-gray-300 whitespace-pre-wrap"><%= @expense.note %></p>
        </div>
      <% end %>

      <%# Receipt %>
      <% if @expense.has_receipt? %>
        <div>
          <label class="text-sm text-gray-500 uppercase tracking-wide">Receipt</label>
          <div class="mt-2 p-4 rounded-xl bg-dark-surface-elevated border border-dark-border">
            <% if @expense.receipt.image? %>
              <div class="text-center">
                <%= image_tag url_for(@expense.receipt), class: "max-w-full max-h-96 rounded-lg mx-auto" %>
                <%= link_to url_for(@expense.receipt), target: "_blank", class: "inline-flex items-center gap-2 mt-3 text-sm text-primary-400 hover:text-primary-300" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Open full size
                <% end %>
              </div>
            <% else %>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-lg bg-red-500/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-white font-medium"><%= @expense.receipt.filename %></p>
                    <p class="text-xs text-gray-500">PDF Document</p>
                  </div>
                </div>
                <%= link_to rails_blob_path(@expense.receipt, disposition: :attachment), class: "btn-secondary btn-sm" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Download
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Metadata %>
      <div class="pt-4 border-t border-dark-border">
        <div class="flex flex-wrap gap-4 text-sm text-gray-500">
          <span>Created: <%= @expense.created_at.strftime("%b %d, %Y at %I:%M %p") %></span>
          <% if @expense.updated_at != @expense.created_at %>
            <span>Updated: <%= @expense.updated_at.strftime("%b %d, %Y at %I:%M %p") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
