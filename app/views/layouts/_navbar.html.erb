<nav class="fixed top-0 left-0 right-0 z-40 glass border-b border-dark-border/50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <%# Logo %>
      <%= link_to root_path, class: "flex items-center gap-3 group" do %>
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <span class="text-xl font-bold text-gradient">ExpenseTracker</span>
      <% end %>

      <%# Navigation Links %>
      <div class="flex items-center gap-2">
        <% if user_signed_in? %>
          <%= link_to root_path, class: "nav-link#{current_page?(root_path) ? ' nav-link-active' : ''}" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="hidden sm:inline">Dashboard</span>
          <% end %>
          
          <%= link_to new_expense_path, class: "btn-primary btn-sm" do %>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline">Add Expense</span>
          <% end %>

          <div class="relative ml-4 pl-4 border-l border-dark-border">
            <div class="flex items-center gap-3">
              <div class="hidden sm:block text-right">
                <p class="text-sm font-medium text-white"><%= current_user.name %></p>
                <p class="text-xs text-gray-400"><%= current_user.email %></p>
              </div>
              <%= button_to destroy_user_session_path, method: :delete, class: "btn-ghost btn-sm", data: { turbo_method: :delete } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                <span class="hidden sm:inline">Logout</span>
              <% end %>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "btn-ghost" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
