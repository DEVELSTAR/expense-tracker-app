<% content_for :title, "My Funds - ExpenseTracker" %>

<div class="animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Funds</h1>
      <p class="page-subtitle">Manage your personal funds and budgets</p>
    </div>
    <%= link_to new_fund_path, class: "btn-primary btn-lg inline-flex items-center gap-2" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <span>Create Personal Fund</span>
    <% end %>
  </div>

  <% if @funds.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @funds.each do |fund| %>
        <div class="card p-6 flex flex-col h-full hover:border-primary-500/30 transition-colors">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-xl font-bold text-white"><%= fund.name %></h3>
              <p class="text-sm text-gray-400">Created <%= time_ago_in_words(fund.created_at) %> ago</p>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to edit_fund_path(fund), class: "p-2 hover:bg-dark-surface-elevated rounded-lg transition-colors text-gray-400 hover:text-white" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
              <%= button_to fund_path(fund), method: :delete, class: "p-2 hover:bg-dark-surface-elevated rounded-lg transition-colors text-gray-400 hover:text-red-400", data: { turbo_confirm: "Are you sure? This will delete the fund and unlink all expenses." } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              <% end %>
            </div>
          </div>

          <div class="mt-auto space-y-4">
            <div>
              <div class="flex items-end justify-between mb-2">
                <span class="text-gray-400">Total Budget</span>
                <span class="text-xl font-bold text-white">₹<%= number_with_precision(fund.amount, precision: 0, delimiter: ",") %></span>
              </div>
              
              <% spent_percent = fund.amount > 0 ? (fund.total_spent / fund.amount * 100).clamp(0, 100) : 0 %>
              <div class="w-full h-2 bg-dark-surface-elevated rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= spent_percent > 90 ? 'bg-red-500' : spent_percent > 60 ? 'bg-yellow-500' : 'bg-green-500' %>" style="width: <%= spent_percent %>%"></div>
              </div>
              
              <div class="flex justify-between text-xs mt-2">
                <span class="text-red-400">Spent: ₹<%= number_with_precision(fund.total_spent, precision: 0, delimiter: ",") %></span>
                <span class="text-green-400">Left: ₹<%= number_with_precision(fund.remaining_balance, precision: 0, delimiter: ",") %></span>
              </div>
            </div>
            
            <%= link_to fund_path(fund), class: "btn-secondary w-full justify-center" do %>
              View Details
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🏦</div>
      <h3 class="empty-state-title">No Funds Created</h3>
      <p class="empty-state-description">
        Create a personal fund to manage specific budgets like "Travel", "Renovation", or "Emergency".
      </p>
      <%= link_to new_fund_path, class: "btn-primary inline-flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Create Personal Fund</span>
      <% end %>
    </div>
  <% end %>
</div>
