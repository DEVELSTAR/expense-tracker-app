<% content_for :title, "My Profile - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Profile</h1>
      <p class="page-subtitle">Manage your account and expenses</p>
    </div>
  </div>

  <%# Profile Card %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-blue-500/25">
        <%= @user.display_name.first.upcase %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white"><%= @user.display_name %></h2>
        <p class="text-gray-400"><%= @user.email %></p>
        <div class="flex items-center gap-2 mt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Dependent
          </span>
          <% if @guardian.present? %>
            <span class="text-xs text-gray-500">(Guardian: <%= @guardian.display_name %>)</span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Stats %>
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-white"><%= @expense_count %></p>
        <p class="text-sm text-gray-400">Expenses</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-primary-400">₹<%= number_with_precision(@total_spent, precision: 0, delimiter: ",") %></p>
        <p class="text-sm text-gray-400">Total Spent</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-secondary-400"><%= @funds_count %></p>
        <p class="text-sm text-gray-400">Assigned Funds</p>
      </div>
    </div>

    <%# Guardian Info %>
    <% if @guardian.present? %>
      <div class="border-t border-dark-border pt-6 mb-6">
        <h3 class="text-lg font-semibold text-white mb-4">My Guardian</h3>
        <div class="p-4 rounded-xl bg-gradient-to-r from-emerald-500/10 to-teal-500/10 border border-emerald-500/20">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center text-white font-bold">
              <%= @guardian.display_name.first.upcase %>
            </div>
            <div>
              <p class="text-white font-medium"><%= @guardian.display_name %></p>
              <p class="text-sm text-gray-400"><%= @guardian.email %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%# Account Settings %>
    <div class="border-t border-dark-border pt-6">
      <h3 class="text-lg font-semibold text-white mb-4">Account Settings</h3>
      <div class="space-y-3">
        <%= link_to edit_profile_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Edit Profile</p>
            <p class="text-sm text-gray-400">Update your name, email and password</p>
          </div>
        <% end %>

        <%= link_to shopping_list_items_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <div>
            <p class="text-white font-medium">My Shopping List</p>
            <p class="text-sm text-gray-400">Remember what to buy</p>
          </div>
        <% end %>

        <%= link_to categories_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <div>
            <p class="text-white font-medium">My Categories</p>
            <p class="text-sm text-gray-400">Manage custom expense types</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Assigned Funds Section %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">Assigned Funds</h3>
      <span class="text-sm text-gray-400">Funds you can spend from</span>
    </div>
    
    <% if @assigned_funds.any? %>
      <div class="space-y-3 mb-4">
        <% @assigned_funds.each do |fund| %>
          <div class="p-4 rounded-xl bg-dark-surface-elevated">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-white font-medium"><%= fund.name %></p>
                <p class="text-sm text-gray-400">Created by <%= fund.admin.display_name %></p>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-secondary-400"><%= fund.formatted_remaining %></p>
                <p class="text-xs text-gray-500">available</p>
              </div>
            </div>
            
            <%# Progress bar showing spent amount %>
            <% spent_percentage = fund.amount > 0 ? ((fund.total_spent / fund.amount) * 100).round : 0 %>
            <div class="mt-3">
              <div class="h-2 bg-dark-border rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-primary-500 to-secondary-500 rounded-full transition-all duration-300" style="width: <%= [spent_percentage, 100].min %>%"></div>
              </div>
              <div class="flex justify-between mt-1">
                <span class="text-xs text-gray-500"><%= spent_percentage %>% used</span>
                <span class="text-xs text-gray-500"><%= fund.formatted_amount %> total</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <% if @funds_count > 5 %>
        <%= link_to funds_path, class: "text-primary-400 hover:text-primary-300 text-sm" do %>
          View all <%= @funds_count %> funds →
        <% end %>
      <% end %>
    <% else %>
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-full bg-secondary-500/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-gray-400 mb-2">No funds assigned yet</p>
        <p class="text-sm text-gray-500">Your guardian will assign funds for you to spend from.</p>
      </div>
    <% end %>
  </div>

  <%# My Expenses Section %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">My Recent Expenses</h3>
      <div class="flex items-center gap-2">
        <%= link_to expenses_path, class: "text-primary-400 hover:text-primary-300 text-sm mr-4" do %>
          View all →
        <% end %>
        <%= link_to new_expense_path, class: "btn-primary btn-sm" do %>
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Add Expense
        <% end %>
      </div>
    </div>
    
    <% if @recent_expenses.any? %>
      <div class="space-y-3">
        <% @recent_expenses.take(5).each do |expense| %>
          <%= link_to expense_path(expense), class: "block p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-white font-medium"><%= expense.category.name.titleize %></p>
                <p class="text-sm text-gray-400"><%= expense.spent_on.strftime("%b %d, %Y") %></p>
                <% if expense.note.present? %>
                  <p class="text-xs text-gray-500 mt-1"><%= truncate(expense.note, length: 50) %></p>
                <% end %>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-primary-400"><%= expense.formatted_amount %></p>
                <p class="text-xs text-gray-500"><%= expense.fund_name %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-full bg-primary-500/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <p class="text-gray-400 mb-2">No expenses recorded yet</p>
        <p class="text-sm text-gray-500 mb-4">Start tracking your spending by adding your first expense.</p>
        <% if @assigned_funds.any? %>
          <%= link_to new_expense_path, class: "btn-primary" do %>
            Add Your First Expense
          <% end %>
        <% else %>
          <p class="text-xs text-amber-400">Wait for your guardian to assign funds to you first.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Logout %>
  <div class="text-center">
    <%= button_to destroy_user_session_path, method: :delete, class: "btn-danger", style: "border-radius: 12px; padding: 10px 24px;" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    <% end %>
  </div>
</div>
