<% content_for :title, "Guardian Profile - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Profile</h1>
      <p class="page-subtitle">Manage your account and dependents</p>
    </div>
  </div>

  <%# Profile Card %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-emerald-500/25">
        <%= @user.display_name.first.upcase %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white"><%= @user.display_name %></h2>
        <p class="text-gray-400"><%= @user.email %></p>
        <div class="flex items-center gap-2 mt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7"/>
            </svg>
            Guardian
          </span>
          <% if @dependents.any? %>
            <span class="text-xs text-gray-500">(<%= @dependents_count %> dependent<%= @dependents_count == 1 ? '' : 's' %>)</span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Stats %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-white"><%= @expense_count %></p>
        <p class="text-sm text-gray-400">My Expenses</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-primary-400">₹<%= number_with_precision(@total_spent, precision: 0, delimiter: ",") %></p>
        <p class="text-sm text-gray-400">Total Spent</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-secondary-400"><%= @managed_funds_count %></p>
        <p class="text-sm text-gray-400">My Funds</p>
      </div>
      <div class="p-4 bg-dark-surface-elevated rounded-xl text-center">
        <p class="text-2xl font-bold text-blue-400"><%= @dependents_count %></p>
        <p class="text-sm text-gray-400">Dependents</p>
      </div>
    </div>

    <%# Guardian UID Section %>
    <div class="border-t border-dark-border pt-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Your Guardian UID</h3>
        <span class="text-xs text-gray-500">Share this code with your dependents</span>
      </div>
      
      <div class="p-4 rounded-xl bg-gradient-to-r from-emerald-500/10 to-teal-500/10 border border-emerald-500/20">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 mb-1">Your unique code</p>
              <p class="text-2xl font-bold font-mono tracking-wider text-emerald-400" id="guardian-uid"><%= @user.guardian_uid %></p>
            </div>
          </div>
          
          <div class="flex items-center gap-2">
            <button type="button" 
                    onclick="copyUid()" 
                    class="btn-secondary btn-sm"
                    title="Copy UID">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span class="hidden sm:inline ml-1">Copy</span>
            </button>
            
            <%= button_to regenerate_guardian_uid_profile_path, 
                method: :post,
                class: "btn-ghost btn-sm text-amber-400 hover:text-amber-300",
                data: { turbo_confirm: "Are you sure you want to regenerate your UID? Dependents using your old code won't be able to link to you anymore." },
                title: "Generate new UID" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <span class="hidden sm:inline ml-1">Regenerate</span>
            <% end %>
          </div>
        </div>
      </div>
      
      <p class="text-xs text-gray-500 mt-3">
        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        When someone registers as a dependent, they'll need to enter this code to link to you as their guardian.
      </p>
    </div>

    <%# Account Settings %>
    <div class="border-t border-dark-border pt-6">
      <h3 class="text-lg font-semibold text-white mb-4">Account Settings</h3>
      <div class="space-y-3">
        <%= link_to edit_profile_path, class: "flex items-center gap-3 p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
          <div>
            <p class="text-white font-medium">Edit Profile</p>
            <p class="text-sm text-gray-400">Update your name, email and password</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# My Dependents Section %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">My Dependents</h3>
      <% if @dependents.any? %>
        <span class="text-sm text-gray-400"><%= @dependents_count %> registered</span>
      <% end %>
    </div>
    
    <% if @dependents.any? %>
      <div class="space-y-3">
        <% @dependents.each do |dependent| %>
          <div class="flex items-center justify-between p-4 rounded-xl bg-dark-surface-elevated">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white font-bold">
                <%= dependent.display_name.first.upcase %>
              </div>
              <div>
                <p class="text-white font-medium"><%= dependent.display_name %></p>
                <p class="text-sm text-gray-400"><%= dependent.email %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm text-primary-400">₹<%= number_with_precision(dependent.expenses.sum(:amount), precision: 0, delimiter: ",") %></p>
              <p class="text-xs text-gray-500"><%= dependent.expenses.count %> expenses</p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-full bg-blue-500/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <p class="text-gray-400 mb-2">No dependents yet</p>
        <p class="text-sm text-gray-500">Share your Guardian UID (<span class="font-mono text-emerald-400"><%= @user.guardian_uid %></span>) with family members to link them as dependents.</p>
      </div>
    <% end %>
  </div>

  <%# My Funds Section %>
  <div class="card p-6 md:p-8 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">My Funds</h3>
      <%= link_to new_fund_path, class: "btn-primary btn-sm" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Fund
      <% end %>
    </div>
    
    <% if @managed_funds.any? %>
      <div class="space-y-3 mb-4">
        <% @managed_funds.each do |fund| %>
          <%= link_to fund_path(fund), class: "block p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-white font-medium"><%= fund.name %></p>
                <p class="text-sm text-gray-400"><%= fund.users.count %> user<%= fund.users.count == 1 ? '' : 's' %> assigned</p>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-secondary-400"><%= fund.formatted_remaining %></p>
                <p class="text-xs text-gray-500">of <%= fund.formatted_amount %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
      <%= link_to funds_path, class: "text-primary-400 hover:text-primary-300 text-sm" do %>
        View all funds →
      <% end %>
    <% else %>
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-full bg-secondary-500/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-gray-400 mb-2">No funds created yet</p>
        <p class="text-sm text-gray-500 mb-4">Create a fund to start tracking your family's budget.</p>
        <%= link_to new_fund_path, class: "btn-primary" do %>
          Create Your First Fund
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Recent Expenses Section %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <%# My Expenses %>
    <div class="card p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">My Recent Expenses</h3>
        <%= link_to expenses_path, class: "text-primary-400 hover:text-primary-300 text-sm" do %>
          View all →
        <% end %>
      </div>
      
      <% if @recent_expenses.any? %>
        <div class="space-y-3">
          <% @recent_expenses.each do |expense| %>
            <div class="flex items-center justify-between p-3 rounded-lg bg-dark-surface-elevated">
              <div>
                <p class="text-white font-medium"><%= expense.category.titleize %></p>
                <p class="text-xs text-gray-500"><%= expense.spent_on.strftime("%b %d") %> • <%= expense.fund_name %></p>
              </div>
              <p class="text-primary-400 font-medium"><%= expense.formatted_amount %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4">No expenses recorded yet</p>
      <% end %>
    </div>

    <%# Dependents' Expenses %>
    <div class="card p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Dependents' Expenses</h3>
        <% if @dependents_total_spent > 0 %>
          <span class="text-sm text-primary-400">₹<%= number_with_precision(@dependents_total_spent, precision: 0, delimiter: ",") %></span>
        <% end %>
      </div>
      
      <% if @dependent_expenses.any? %>
        <div class="space-y-3">
          <% @dependent_expenses.each do |expense| %>
            <div class="flex items-center justify-between p-3 rounded-lg bg-dark-surface-elevated">
              <div>
                <p class="text-white font-medium"><%= expense.category.titleize %></p>
                <p class="text-xs text-gray-500">
                  <%= expense.user.display_name %> • <%= expense.spent_on.strftime("%b %d") %>
                </p>
              </div>
              <p class="text-blue-400 font-medium"><%= expense.formatted_amount %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4">No dependent expenses yet</p>
      <% end %>
    </div>
  </div>

  <%# Logout %>
  <div class="text-center">
    <%= button_to destroy_user_session_path, method: :delete, class: "btn-danger", style: "border-radius: 12px; padding: 10px 24px;" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    <% end %>
  </div>
</div>

<script>
  function copyUid() {
    const uid = document.getElementById('guardian-uid').textContent;
    navigator.clipboard.writeText(uid).then(() => {
      alert('UID copied to clipboard!');
    });
  }
</script>
