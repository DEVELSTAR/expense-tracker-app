<% content_for :title, "#{@dependent.display_name} - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div class="flex items-center gap-4">
      <%= link_to guardian_dependents_path, class: "p-2 rounded-lg hover:bg-dark-surface-elevated transition-colors text-gray-400 hover:text-white" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-blue-500/25">
          <%= @dependent.display_name.first.upcase %>
        </div>
        <div>
          <h1 class="page-title"><%= @dependent.display_name %></h1>
          <p class="page-subtitle"><%= @dependent.email %></p>
        </div>
      </div>
    </div>
  </div>

  <%# Stats %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="card p-6">
      <span class="text-gray-400 text-sm">Total Expenses</span>
      <p class="text-2xl font-bold text-white mt-1"><%= @expenses.count %></p>
    </div>
    
    <div class="card p-6">
      <span class="text-gray-400 text-sm">Total Spent</span>
      <p class="text-2xl font-bold text-primary-400 mt-1">₹<%= number_with_precision(@total_spent, precision: 0, delimiter: ",") %></p>
    </div>

    <div class="card p-6">
      <span class="text-gray-400 text-sm">Assigned Funds</span>
      <p class="text-2xl font-bold text-secondary-400 mt-1"><%= @funds.count %></p>
    </div>
  </div>

  <%# Assigned Funds %>
  <div class="card p-6 mb-8">
    <h3 class="text-lg font-semibold text-white mb-4">Assigned Funds</h3>
    
    <% if @funds.any? %>
      <div class="space-y-3">
        <% @funds.each do |fund| %>
          <%= link_to fund_path(fund), class: "block p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-white font-medium"><%= fund.name %></p>
                <p class="text-sm text-gray-400">
                  Spent: ₹<%= number_with_precision(fund.spent_by_user(@dependent), precision: 0, delimiter: ",") %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-secondary-400"><%= fund.formatted_remaining %></p>
                <p class="text-xs text-gray-500">remaining</p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">No funds assigned to this dependent yet.</p>
    <% end %>
  </div>

  <%# Recent Expenses %>
  <div class="card">
    <div class="p-6 border-b border-dark-border">
      <h2 class="text-lg font-semibold text-white">Recent Expenses</h2>
    </div>
    <% if @expenses.any? %>
      <div class="divide-y divide-dark-border">
        <% @expenses.each do |expense| %>
          <div class="p-4 flex items-center justify-between hover:bg-dark-surface-elevated/50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-primary-500/10 flex items-center justify-center text-primary-400">
                <%= expense.category[0].upcase %>
              </div>
              <div>
                <p class="font-medium text-white"><%= expense.category.titleize %></p>
                <p class="text-sm text-gray-400">
                  <%= expense.spent_on.strftime("%b %d, %Y") %>
                  <% if expense.fund.present? %>
                    • <%= expense.fund.name %>
                  <% end %>
                </p>
                <% if expense.note.present? %>
                  <p class="text-xs text-gray-500 mt-1"><%= truncate(expense.note, length: 50) %></p>
                <% end %>
              </div>
            </div>
            <div class="text-right">
              <p class="font-semibold text-red-400">-<%= expense.formatted_amount %></p>
              <%= link_to "View", expense_path(expense), class: "text-xs text-primary-400 hover:text-primary-300" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center text-gray-400">
        No expenses recorded by this dependent yet.
      </div>
    <% end %>
  </div>
</div>
