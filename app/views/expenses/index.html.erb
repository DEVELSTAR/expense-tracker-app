<% content_for :title, "My Expenses - ExpenseTracker" %>

<div class="max-w-4xl mx-auto animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Expenses</h1>
      <p class="page-subtitle">Track and manage your spending</p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to export_expenses_path(format: :csv), class: "btn-secondary flex items-center gap-2" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span class="hidden sm:inline">Export CSV</span>
      <% end %>
      <%= link_to new_expense_path, class: "btn-primary flex items-center gap-2" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span class="hidden sm:inline">Add Expense</span>
      <% end %>
    </div>
  </div>

  <%# My Expenses %>
  <div class="card p-6 mb-6">
    <h3 class="text-lg font-semibold text-white mb-4">My Expenses</h3>
    
    <% if @own_expenses.any? %>
      <div class="space-y-3">
        <% @own_expenses.each do |expense| %>
          <%= link_to expense_path(expense), class: "block p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-primary-500/20 flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <div>
                  <p class="text-white font-medium"><%= expense.category&.name&.titleize %></p>
                  <p class="text-sm text-gray-400">
                    <%= expense.spent_on.strftime("%b %d, %Y") %>
                    <% if expense.fund.present? %>
                      • <%= expense.fund.name %>
                    <% end %>
                  </p>
                  <% if expense.note.present? %>
                    <p class="text-xs text-gray-500 mt-1"><%= truncate(expense.note, length: 60) %></p>
                  <% end %>
                </div>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-primary-400"><%= expense.formatted_amount %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-full bg-primary-500/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <p class="text-gray-400 mb-2">No expenses recorded yet</p>
        <p class="text-sm text-gray-500 mb-4">Start tracking your spending by adding your first expense.</p>
        <%= link_to new_expense_path, class: "btn-primary" do %>
          Add Your First Expense
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Dependents' Expenses (Guardian Only) %>
  <% if @show_dependent_expenses %>
    <div class="card p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Dependents' Expenses</h3>
        <span class="text-sm text-gray-400"><%= @dependent_expenses.count %> expenses</span>
      </div>
      
      <div class="space-y-3">
        <% @dependent_expenses.each do |expense| %>
          <%= link_to expense_path(expense), class: "block p-4 rounded-xl bg-dark-surface-elevated hover:bg-dark-border transition-colors" do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white font-bold text-sm">
                  <%= expense.user.display_name.first.upcase %>
                </div>
                <div>
                  <p class="text-white font-medium"><%= expense.category&.name&.titleize %></p>
                  <p class="text-sm text-gray-400">
                    <%= expense.user.display_name %> • <%= expense.spent_on.strftime("%b %d, %Y") %>
                    <% if expense.fund.present? %>
                      • <%= expense.fund.name %>
                    <% end %>
                  </p>
                  <% if expense.note.present? %>
                    <p class="text-xs text-gray-500 mt-1"><%= truncate(expense.note, length: 60) %></p>
                  <% end %>
                </div>
              </div>
              <div class="text-right">
                <p class="text-lg font-bold text-blue-400"><%= expense.formatted_amount %></p>
                <p class="text-xs text-gray-500">View only</p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
