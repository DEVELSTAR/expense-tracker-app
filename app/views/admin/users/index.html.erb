<% content_for :title, "Manage Users - Admin" %>

<div class="animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">Manage Users</h1>
      <p class="page-subtitle">Create, edit, and manage user accounts</p>
    </div>
    <%= link_to admin_users_path, class: "btn-primary" do %>
      <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Add User
    <% end %>
  </div>

  <div class="card">
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Expenses</th>
            <th>Created At</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="text-white font-medium"><%= user.display_name %></td>
              <td class="text-gray-400"><%= user.email %></td>
              <td>
                <% if user.admin? %>
                  <span class="badge-warning">Admin</span>
                <% else %>
                  <span class="badge-secondary">User</span>
                <% end %>
              </td>
              <td class="text-gray-400"><%= user.expenses.count %> expenses</td>
              <td class="text-gray-500 text-sm"><%= user.created_at.strftime("%b %d, %Y") %></td>
              <td class="text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to edit_admin_user_path(user), class: "btn-ghost btn-sm" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                  <% unless user.admin? || user == current_user %>
                    <%= button_to admin_user_path(user), method: :delete,
                        class: "btn-ghost btn-sm text-red-400 hover:text-red-300",
                        data: { turbo_confirm: "Are you sure you want to delete #{user.display_name}? This will also delete all their expenses." } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
