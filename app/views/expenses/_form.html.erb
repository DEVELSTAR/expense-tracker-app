<%= form_with model: expense, class: "space-y-6" do |f| %>
  <% if expense.errors.any? %>
    <div class="alert-error">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h3 class="font-medium"><%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:</h3>
          <ul class="mt-2 list-disc list-inside text-sm">
            <% expense.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="form-grid">
    <%# Amount Field %>
    <div class="input-group">
      <%= f.label :amount, class: "input-label" %>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">₹</span>
        <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "0.00", class: "input pl-10" %>
      </div>
    </div>

    <%# Date Field %>
    <div class="input-group">
      <%= f.label :spent_on, "Date", class: "input-label" %>
      <%= f.date_field :spent_on, class: "input" %>
    </div>

    <%# Category Field %>
    <div class="input-group">
      <%= f.label :category, class: "input-label" %>
      <%= f.select :category, 
          options_for_select(Expense::CATEGORIES.map { |c| [c.capitalize, c] }, expense.category),
          { include_blank: "Select category" },
          class: "select" %>
    </div>

    <%# Fund Selection (if user has funds) %>
    <% if @funds.present? && @funds.any? %>
      <div class="input-group">
        <%= f.label :fund_id, "Pay From", class: "input-label" %>
        <%= f.select :fund_id,
            options_for_select(
              @funds.map { |fund| ["#{fund.name} (₹#{number_with_precision(fund.remaining_balance, precision: 0, delimiter: ',')} left)", fund.id] },
              expense.fund_id
            ),
            { include_blank: "Personal (No Fund)" },
            class: "select" %>
        <p class="text-xs text-gray-500 mt-1">Select a fund to deduct from, or leave empty for personal expense</p>
      </div>
    <% end %>
  </div>

  <%# Note Field %>
  <div class="input-group">
    <%= f.label :note, class: "input-label" %>
    <%= f.text_area :note, 
        placeholder: "Add any additional details about this expense...",
        rows: 3,
        class: "textarea" %>
  </div>

  <%# Form Actions %>
  <div class="form-actions border-t border-dark-border pt-6">
    <%= f.submit expense.new_record? ? "Add Expense" : "Update Expense", class: "btn-primary btn-lg" %>
    <%= link_to "Cancel", root_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
