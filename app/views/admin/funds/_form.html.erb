<%= form_with model: [:admin, fund], class: "space-y-6" do |f| %>
  <% if fund.errors.any? %>
    <div class="alert-error">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h3 class="font-medium"><%= pluralize(fund.errors.count, "error") %> prohibited this fund from being saved:</h3>
          <ul class="mt-2 list-disc list-inside text-sm">
            <% fund.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="input-group">
      <%= f.label :name, "Fund Name", class: "input-label" %>
      <%= f.text_field :name, placeholder: "e.g., Monthly Household", class: "input" %>
    </div>

    <div class="input-group">
      <%= f.label :amount, "Amount (₹)", class: "input-label" %>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">₹</span>
        <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "0.00", class: "input pl-10" %>
      </div>
    </div>
  </div>

  <%# User Assignment %>
  <div class="input-group">
    <%= f.label :user_ids, "Assign Users", class: "input-label" %>
    <p class="text-sm text-gray-400 mb-3">Select users who can spend from this fund</p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      <% @users.each do |user| %>
        <label class="flex items-center gap-3 p-3 rounded-lg bg-dark-surface cursor-pointer hover:bg-dark-surface-elevated transition-colors border border-dark-border has-[:checked]:border-primary-500 has-[:checked]:bg-primary-500/10">
          <%= check_box_tag "fund[user_ids][]", user.id, fund.users.include?(user), class: "w-4 h-4 rounded border-dark-border text-primary-500 focus:ring-primary-500 bg-dark-surface" %>
          <div>
            <p class="text-white font-medium"><%= user.display_name %></p>
            <p class="text-xs text-gray-400"><%= user.email %></p>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-actions border-t border-dark-border pt-6">
    <%= f.submit fund.new_record? ? "Create Fund" : "Update Fund", class: "btn-primary btn-lg" %>
    <%= link_to "Cancel", admin_funds_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
