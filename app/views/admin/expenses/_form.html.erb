<%= form_with model: [:admin, expense], class: "space-y-6" do |f| %>
  <% if expense.errors.any? %>
    <div class="alert-error">
      <h3 class="font-medium mb-1"><%= pluralize(expense.errors.count, "error") %> prohibited saving:</h3>
      <ul class="list-disc list-inside text-sm">
         <% expense.errors.full_messages.each do |msg| %>
           <li><%= msg %></li>
         <% end %>
      </ul>
    </div>
  <% end %>

  <div class="input-group">
    <%= f.label :amount, class: "input-label" %>
    <div class="relative">
       <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">₹</span>
       <%= f.number_field :amount, step: 0.01, class: "input pl-8" %>
    </div>
  </div>

  <div class="input-group">
    <%= f.label :spent_on, "Date", class: "input-label" %>
    <%= f.date_field :spent_on, class: "input" %>
  </div>

  <div class="input-group">
    <%= f.label :category_id, "Category", class: "input-label" %>
    <%= f.collection_select :category_id, 
        Category.available_to(expense.user), 
        :id, :name, 
        { include_blank: "Select Category" }, 
        class: "select" %>
  </div>

  <div class="input-group">
    <%= f.label :fund_id, "Fund", class: "input-label" %>
    <%= f.collection_select :fund_id, 
        @funds, 
        :id, :name, 
        { include_blank: "Personal (No Fund)" }, 
        class: "select" %>
  </div>

  <div class="input-group">
    <%= f.label :note, class: "input-label" %>
    <%= f.text_area :note, rows: 3, class: "textarea" %>
  </div>

  <div class="flex gap-4 pt-4 border-t border-dark-border">
    <%= f.submit "Update Expense", class: "btn-primary flex-1" %>
    <%= link_to "Cancel", admin_expenses_path, class: "btn-secondary" %>
  </div>
<% end %>
