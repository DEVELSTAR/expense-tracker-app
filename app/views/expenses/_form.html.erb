<%= form_with model: expense, class: "space-y-6" do |f| %>
  <% if expense.errors.any? %>
    <div class="alert-error">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h3 class="font-medium"><%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:</h3>
          <ul class="mt-2 list-disc list-inside text-sm">
            <% expense.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="form-grid">
    <%# Amount Field %>
    <div class="input-group">
      <%= f.label :amount, class: "input-label" %>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">₹</span>
        <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "0.00", class: "input pl-10" %>
      </div>
    </div>

    <%# Date Field %>
    <div class="input-group">
      <%= f.label :spent_on, "Date", class: "input-label" %>
      <%= f.date_field :spent_on, class: "input" %>
    </div>

    <%# Category Field %>
    <div class="input-group">
      <%= f.label :category_id, "Category", class: "input-label" %>
      <%= f.collection_select :category_id, 
          Category.available_to(current_user).order(:name), 
          :id, :name, 
          { include_blank: "Select category" }, 
          class: "select" %>
    </div>

    <%# Fund Selection (if user has funds) %>
    <% if @funds.present? && @funds.any? %>
      <div class="input-group">
        <%= f.label :fund_id, "Pay From", class: "input-label" %>
        <%= f.select :fund_id,
            options_for_select(
              @funds.map { |fund| ["#{fund.name} (₹#{number_with_precision(fund.remaining_balance, precision: 0, delimiter: ',')} left)", fund.id] },
              expense.fund_id
            ),
            { include_blank: "Personal (No Fund)" },
            class: "select" %>
        <p class="text-xs text-gray-500 mt-1">Select a fund to deduct from, or leave empty for personal expense</p>
      </div>
    <% end %>
  </div>

  <%# Note Field %>
  <div class="input-group">
    <%= f.label :note, class: "input-label" %>
    <%= f.text_area :note, 
        placeholder: "Add any additional details about this expense...",
        rows: 3,
        class: "textarea" %>
  </div>

  <%# Receipt Upload %>
  <div class="input-group">
    <%= f.label :receipt, "Receipt (optional)", class: "input-label" %>
    <div class="relative">
      <% if expense.receipt.attached? %>
        <div class="mb-3 p-3 rounded-lg bg-dark-surface-elevated border border-dark-border">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-white text-sm font-medium">Receipt attached</p>
                <p class="text-xs text-gray-500"><%= expense.receipt.filename %></p>
              </div>
            </div>
            <% if expense.receipt.image? %>
              <%= link_to url_for(expense.receipt), target: "_blank", class: "text-sm text-primary-400 hover:text-primary-300" do %>
                View
              <% end %>
            <% end %>
          </div>
        </div>
        <p class="text-xs text-gray-500 mb-2">Upload a new file to replace the existing receipt:</p>
      <% end %>
      
      <div class="border-2 border-dashed border-dark-border rounded-xl p-6 text-center hover:border-primary-500/50 transition-colors cursor-pointer" onclick="document.getElementById('expense_receipt').click()">
        <div class="flex flex-col items-center gap-2">
          <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-gray-400 text-sm">Click to upload or drag and drop</p>
          <p class="text-gray-500 text-xs">PNG, JPG, GIF, WebP or PDF (max 5MB)</p>
        </div>
      </div>
      <%= f.file_field :receipt, 
          accept: "image/*,.pdf",
          class: "hidden",
          id: "expense_receipt" %>
    </div>
  </div>

  <%# Form Actions %>
  <div class="form-actions border-t border-dark-border pt-6">
    <%= f.submit expense.new_record? ? "Add Expense" : "Update Expense", class: "btn-primary btn-lg" %>
    <%= link_to "Cancel", root_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
